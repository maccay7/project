MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password_here
MYSQL_DATABASE=dura_capital

# Long random string (e.g. openssl rand -hex 32). Required for signed session tokens.
FLASK_SECRET_KEY=

# Must match the only user email you keep in `users` (see schema.sql).
ALLOWED_LOGIN_EMAIL=makanakakanyai@gmail.com

# Session lifetime for API Bearer token (seconds). Default 8 hours.
TOKEN_MAX_AGE_SECONDS=28800

PORT=3000

# Optional: extra dev origins (comma-separated) if you open the app via LAN IP
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://192.168.1.5:5173

# Optional: live yield-curve API endpoint.
# Expected payload:
# { "points": { "treasury_bills": [{"days":91,"rate":4.5}], "money_market": [{"days":30,"rate":4.2}] } }
YIELD_CURVE_API_URL=

# FRED API key (get this from your FRED account settings).
# If present, backend uses FRED series for treasury + money market curves.
FRED_API_KEY=

# St. Louis Fed API key for yield curve data
STLOUIS_FED_API_KEY=b40141a5119f30bc2388d63f59d8847e
