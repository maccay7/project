# Frontend Environment Variables
# API Configuration
VITE_API_BASE_URL=http://localhost:5000
REACT_APP_API_BASE_URL=http://localhost:5000

# App Configuration
VITE_APP_NAME=DuraCapital Financial Analytics
REACT_APP_APP_NAME=DuraCapital Financial Analytics

# File Upload Configuration
VITE_MAX_FILE_SIZE=52428800
REACT_APP_MAX_FILE_SIZE=52428800

# Allowed File Types (comma-separated)
VITE_ALLOWED_FILE_TYPES=.csv,.xlsx,.xls,.xlsm,.xlsb,.json,.pdf,.doc,.docx,.docm,.png,.jpg,.jpeg,.gif,.bmp,.tiff,.tif,.txt,.rtf,.xml,.zip,.rar,.7z,.tar,.gz,.odt,.ods,.odp,.ppt,.pptx,.pptm
REACT_APP_ALLOWED_FILE_TYPES=.csv,.xlsx,.xls,.xlsm,.xlsb,.json,.pdf,.doc,.docx,.docm,.png,.jpg,.jpeg,.gif,.bmp,.tiff,.tif,.txt,.rtf,.xml,.zip,.rar,.7z,.tar,.gz,.odt,.ods,.odp,.ppt,.pptx,.pptm

# Rate Limiting
VITE_RATE_LIMIT_MESSAGE=Too many requests. Please try again later.
REACT_APP_RATE_LIMIT_MESSAGE=Too many requests. Please try again later.
